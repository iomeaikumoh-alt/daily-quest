# API server (artifacts/api-server) — set these in Replit Secrets or your shell.
# Never commit real values. Without ANTHROPIC_API_KEY the server uses the rule-based mock AI.

# Anthropic API key for Claude. Required for real AI parsing/breakdown.
ANTHROPIC_API_KEY=

# Optional. Claude model id (default: claude-haiku-5-5).
ANTHROPIC_MODEL=

# Optional. "claude" or "mock". Default: claude when ANTHROPIC_API_KEY is set, otherwise mock.
AI_PROVIDER=

# Optional. Per-request Claude timeout in ms (default: 15000).
AI_TIMEOUT_MS=

# Optional. Max AI requests per client IP per minute (default: 20).
AI_RATE_LIMIT_PER_MIN=

# Mobile app (artifacts/daily-quest-mobile) — public host of the API server, without https://
EXPO_PUBLIC_DOMAIN=
